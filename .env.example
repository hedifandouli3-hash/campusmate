# ==============================================================================
# CampusMate Environment Configuration
# Copy this file to .env.local and fill in your credentials.
# Never commit .env.local or expose server-only keys to the client.
# ==============================================================================

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demonstration Mode
# Set to "true" to enable clearly labeled local/demo mode with fictional ISET Béja data
# and demo AI fallbacks when external APIs are unavailable.
# Set to "false" in production when connected to live Supabase + Gemini.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_MODE=true
ALLOW_DEMO_LOGIN=true

# Session & Encryption Secrets (generate strong random 32+ char strings in production)
SESSION_SECRET=replace-with-secure-random-32-char-secret
CHAT_ENCRYPTION_KEY=replace-with-secure-random-32-char-chat-key

# ==============================================================================
# Supabase Configuration (PostgreSQL + Auth + Storage + Realtime + pgvector)
# Supports both Supabase Publishable/Secret keys and legacy Anon/Service-Role keys
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (NEVER expose in client components or NEXT_PUBLIC_ vars)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# ==============================================================================
# Artificial Intelligence Provider (Google Gemini API via @google/genai)
# Supports single key (GEMINI_API_KEY) or comma-separated failover pool (GEMINI_API_KEYS)
# ==============================================================================
GEMINI_API_KEY=
GEMINI_API_KEYS=
AI_PROVIDER=gemini
AI_GENERATION_MODEL=gemini-3.8-flash
AI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_EMBEDDING_MODEL=gemini-embedding-001

# Optional OCR endpoint for scanned PDFs (leave blank if unused)
OCR_SERVICE_URL=
OCR_SERVICE_API_KEY=

# Optional Email Provider (e.g., Resend or SMTP — optional for demo)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=noreply@campusmate.example
